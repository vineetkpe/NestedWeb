# Supabase Auth SSR configuration. Use the Project URL and publishable key from
# the Supabase project Connect dialog. These are public client credentials; do
# not put service-role or secret keys in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional until explicitly configuring the server-only Firecrawl adapter.
# Put a real key in an ignored .env.local or the deployment secret store.
# A credential alone does not enable live crawling; see ARCHITECTURE.md ADR-008.
FIRECRAWL_API_KEY=

# Server-only scan worker. New deployments should use a Supabase secret key,
# not the legacy service_role JWT. Keep every value below out of NEXT_PUBLIC_*.
# The worker remains inert unless the enable flag is exactly "true" AND the
# database provider/workspace/project controls independently allow execution.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
GEMINI_API_KEY=
NESTEDWEB_SCAN_WORKER_ID=
NESTEDWEB_SCAN_LEASE_SECONDS=60
NESTEDWEB_LIVE_SCAN_WORKER_ENABLED=false
